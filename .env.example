# ---- Frontend (public, safe to ship to the browser) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Environment name: "staging" shows a ribbon on every screen; "production" (or empty) shows nothing
VITE_APP_ENV=staging
# Optional: default branch for guest screens (otherwise the first active branch)
VITE_DEFAULT_BRANCH_ID=
# Kiosk idle timeout in ms (default 90000)
VITE_KIOSK_IDLE_MS=90000

# ---- Edge Function secrets (NEVER put these in the frontend .env) ----
# supabase secrets set GEMINI_API_KEY=... APP_BASE_URL=https://your-domain
# GEMINI_API_KEY=
# APP_BASE_URL=

# ---- Database settings (run once as the DB owner; never commit real values) ----
# alter database postgres set app.keybox_key   = '<32+ random chars>';
# alter database postgres set app.identity_key = '<32+ random chars>';
